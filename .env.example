# Configurazione backend di Delicon (copiare in .env e valorizzare).
# Le variabili VITE_* vengono incluse nel bundle al momento della build:
# NON metterci segreti di produzione (vedi docs/API.md §Autenticazione).

# Backend da usare: "mock" (dati demo, nessuna rete) oppure "rest".
VITE_BACKEND=mock

# --- Backend REST (endpoint TBD) ---
# Origine del servizio, senza slash finale. Es. https://api.example.com
VITE_API_BASE_URL=
# Template dei path: {shipmentId} viene sostituito (URL-encoded).
VITE_API_SHIPMENT_PATH=/shipments/{shipmentId}
VITE_API_EVENTS_PATH=/shipments/{shipmentId}/events
# Autenticazione: none | bearer | basic | apikey
VITE_API_AUTH=none
# bearer → token; basic → "utente:password"; apikey → valore della chiave
VITE_API_CREDENTIALS=
# Nome dell'header per apikey
VITE_API_KEY_HEADER=X-Api-Key
# Timeout delle richieste (ms)
VITE_API_TIMEOUT_MS=15000

# Trasporto dimostrativo: servito SEMPRE dal mock, anche con VITE_BACKEND=rest,
# così la demo funziona a prescindere dal backend configurato.
VITE_DEMO_SHIPMENT_ID=0000000873
