# Copiare in keystore.properties (NON versionato) e valorizzare.
# storeFile è relativo alla cartella android/. Il keystore stesso (.jks)
# non deve stare nel repository: conservarlo con una copia di sicurezza,
# perché senza la stessa chiave non si possono aggiornare le app installate.
storeFile=../../delicon-release.jks
storePassword=
keyAlias=delicon
keyPassword=
